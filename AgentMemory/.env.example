# Copy to .env on the remote host, then review every path. Never commit secrets.

# ============ Required ============
PERSONAL_ROOT=/public/home/wwxia/yuang.li
PYTHONPATH=/public/home/wwxia/yuang.li/workspace/AgentMemory:/public/home/wwxia/yuang.li/workspace/AgentMemory/methods/RecMem
OPENAI_API_KEY=EMPTY
MODEL=qwen3-vl-32b-instruct

# ============ Optional: custom OpenAI-compatible endpoint ============
# Use a relay / proxy / self-hosted OpenAI-compatible server.
# Either name works; OPENAI_API_BASE takes precedence over OPENAI_BASE_URL
# when both are set.
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_BASE=http://127.0.0.1:8000/v1

# ============ Local vLLM Embedding Service (optional) ============
# The LLM uses OPENAI_BASE_URL; embeddings use a separate endpoint.
# Qwen3-Embedding-0.6B outputs 1024-dimensional vectors.
EMBEDDING_API_KEY=EMPTY
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
EMBEDDING_API_BASE=http://127.0.0.1:8001/v1
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_DIM=1024
EMBEDDING_SEND_DIMENSIONS=false

# ============ LoCoMo Benchmark Paths ============
LOCOMO_PATH=/public/home/wwxia/yuang.li/workspace/AgentMemory/artifacts/data/Locomo/locomo10.json
LOCOMO_SCORE_PATH=/public/home/wwxia/yuang.li/workspace/AgentMemory/artifacts/results/Locomo/scores

# ============ LongMemEval-S Benchmark Paths ============
LONGMEMEVAL_S_PATH=/public/home/wwxia/yuang.li/workspace/AgentMemory/artifacts/data/LongMemEval/longmemeval_s_cleaned.json
LONGMEMEVAL_S_SCORE_PATH=/public/home/wwxia/yuang.li/workspace/AgentMemory/artifacts/results/LongMemEval/scores

# ============ Optional: per-layer Qdrant storage paths ============
# These are fallbacks for the --semantic_store / --subconscious_store /
# --episodic_store CLI flags. Set them here if you'd rather not pass them
# on the command line every time. The values in the example run commands
# in REPRODUCTION.md use CLI flags, so these are optional.
SEMANTIC_STORE=/public/home/wwxia/yuang.li/workspace/AgentMemory/artifacts/stores/recmem/semantic
SUBCONSCIOUS_STORE=/public/home/wwxia/yuang.li/workspace/AgentMemory/artifacts/stores/recmem/subconscious
EPISODIC_STORE=/public/home/wwxia/yuang.li/workspace/AgentMemory/artifacts/stores/recmem/episodic

NLTK_DATA=/public/home/wwxia/yuang.li/workspace/AgentMemory/artifacts/cache/nltk_data
PIP_CACHE_DIR=/public/home/wwxia/yuang.li/workspace/AgentMemory/artifacts/cache/pip
HF_HOME=/public/home/wwxia/yuang.li/models/.cache
